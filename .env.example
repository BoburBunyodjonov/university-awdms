# Copy to apps/backend/.env for local backend, or apps/frontend/.env for Vite overrides.
# Docker Compose production: create apps/backend/.env.production (see section below).

# Prisma — local Postgres (direct + URL can match when not using Supabase pooler)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/awdms?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/awdms?schema=public"

# Backend
PORT=4000
NODE_ENV=development

# JWT — use strong random values in production
JWT_ACCESS_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-too-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS — frontend origin (local Vite default :5173)
CORS_ORIGIN="http://localhost:5173"

# Seed users (optional; used when running seed)
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="change-me"
INITIAL_TEACHER_EMAIL="teacher@example.com"
INITIAL_TEACHER_PASSWORD="change-me"

# Frontend (Vite — must be prefixed with VITE_)
VITE_API_BASE_URL="http://localhost:4000/api"

# --- Production (Docker): file apps/backend/.env.production ---
# Set NODE_ENV=production, CORS_ORIGIN=https://your-domain.com
# Supabase: DATABASE_URL = pooler (e.g. port 6543, ?pgbouncer=true), DIRECT_URL = direct (port 5432)
# Compose build: optional root .env with VITE_API_BASE_URL=/api
#
# If `docker compose` fails with "bind ... :80: address already in use", create a
# file `.env` in the repo root (same folder as docker-compose.prod.yml) with e.g.:
#   AWDMS_HTTP_PUBLISH=127.0.0.1:8080
# Then configure the host's nginx (still on :80 / :443) to:
#   proxy_pass http://127.0.0.1:8080;
# Or use another free port, e.g. 127.0.0.1:30080:80
#
# Backend API on the host (for system nginx location /api → 127.0.0.1:4000):
#   AWDMS_BACKEND_PUBLISH=127.0.0.1:4000:4000
# (default in docker-compose.prod.yml; change left side if 4000 is busy on the host)
